#   testCaseResults[1]: verdict=AC  input2  — n=8, expected 11
#   testCaseResults[2]: verdict=AC  input3  — all-negative, expected -3
#   testCaseResults[3]: verdict=AC  input4  — single element, expected 7
#   testCaseResults[4]: verdict=AC  input5  — n=10, expected 25
